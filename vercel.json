{
  "functions": {
    "api/preview.js": {
      "includeFiles": "{index,book,forum,post,ministry}.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "book" }],
      "destination": "/api/preview?page=index"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "book" }],
      "destination": "/api/preview?page=index"
    },
    {
      "source": "/forum.html",
      "has": [{ "type": "query", "key": "testimony" }],
      "destination": "/api/preview?page=forum"
    },
    {
      "source": "/forum.html",
      "has": [{ "type": "query", "key": "event" }],
      "destination": "/api/preview?page=forum"
    },
    {
      "source": "/book.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/preview?page=book"
    },
    {
      "source": "/book.html",
      "has": [{ "type": "query", "key": "book" }],
      "destination": "/api/preview?page=book"
    },
    {
      "source": "/post.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/preview?page=post"
    },
    {
      "source": "/ministry.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/preview?page=ministry"
    }
  ]
}
