{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "functions": {
    "api/preview.js": {
      "includeFiles": "{index,book,post,ministry}.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "book" }],
      "destination": "/api/preview?page=index"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "book" }],
      "destination": "/api/preview?page=index"
    },
    {
      "source": "/book.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/preview?page=book"
    },
    {
      "source": "/book.html",
      "has": [{ "type": "query", "key": "book" }],
      "destination": "/api/preview?page=book"
    },
    {
      "source": "/post.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/preview?page=post"
    },
    {
      "source": "/ministry.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/preview?page=ministry"
    }
  ]
}
